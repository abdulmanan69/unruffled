      "{ baseMs: 500, factor: 2, maxMs: 30000, jitter: 0.5 }. Jitter is on by default, because without it every client that failed together retries together.",
  },
  {
    name: "parseRetryAfter",
    type: "(value: string | null | undefined, nowMs: number) => number | undefined",
    description: "Both forms the header allows. A date in the past means retry now, not a negative wait.",
  },
  {
    name: "createKeyRegistry",
    type: "() => KeyRegistry",
    description:
      "acquire, isHeld, size, clear. A fresh registry per test case keeps a leaked lock from making the next case look like a duplicate submit.",
  },
  {
    name: "globalKeyRegistry",
    type: "KeyRegistry",
    description:
      "The process-wide registry. This is what makes a key serialise two components in two different subtrees.",
  },
  {
    name: "defaultPorts",
    type: "() => Ports",
    description:
      "Platform-neutral fallbacks. clock and transport are real, because setTimeout and AbortController exist everywhere; everything DOM-shaped is inert, so core degrades to doing nothing rather than throwing.",
  },
  {
    name: "resolvePorts",
    type: "(partial?: Partial<Ports>) => Ports",
    description: "Fills the gaps in a partial bundle.",
  },
  { name: "DEFAULT_PENDING", type: "PendingPolicy", description: "{ delay: 150, min: 400 }." },
  {
    name: "ANNOUNCE_THRESHOLD_MS",
    type: "number",
    description:
      "400. Visible pending time past which silence is a defect, which is the condition UX1003 reports.",
  },
];

const diagnosticsExports = [
