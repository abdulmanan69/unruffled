{
  "name": "@unruffled/react",
  "version": "0.1.0",
  "description": "React hooks and prop-getters for unruffled. Declare an action once - pending policy, guard, error taxonomy, undo window, focus policy and screen-reader announcements come with it.",
  "license": "MIT",
  "author": "Abdul Manan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdulmanan69/unruffled.git",
    "directory": "packages/react"
  },
  "homepage": "https://abdulmanan69.github.io/unruffled/",
  "bugs": "https://github.com/abdulmanan69/unruffled/issues",
  "keywords": [
    "unruffled",
    "ux",
    "react",
    "hooks",
    "async-button",
    "loading-state",
    "undo",
    "confirm",
    "accessibility"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/index.development.js",
      "default": "./dist/index.js"
    },
    "./action": {
      "types": "./dist/action.d.ts",
      "development": "./dist/action.development.js",
      "default": "./dist/action.js"
    },
    "./failure": {
      "types": "./dist/failure.d.ts",
      "development": "./dist/failure.development.js",
      "default": "./dist/failure.js"
    },
    "./undoable": {
      "types": "./dist/undoable.d.ts",
      "development": "./dist/undoable.development.js",
      "default": "./dist/undoable.js"
    },
    "./announce": {
      "types": "./dist/announce.d.ts",
      "development": "./dist/announce.development.js",
      "default": "./dist/announce.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@unruffled/core": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "build": "tsdown && tsdown -c tsdown.dev.config.ts",
    "dev": "tsdown -c tsdown.dev.config.ts --watch",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "@unruffled/react + core, full barrel",
      "path": "dist/index.js",
      "limit": "9.5 kB",
      "ignore": [
        "react"
      ]
    },
    {
      "name": "useAction + core",
      "path": "dist/action.js",
      "limit": "6.6 kB",
      "ignore": [
        "react"
      ]
    },
    {
      "name": "useAction, react layer only",
      "path": "dist/action.js",
      "limit": "2.5 kB",
      "ignore": [
        "react",
        "@unruffled/core"
      ]
    },
    {
      "name": "Announcer, react layer only",
      "path": "dist/announce.js",
      "limit": "1.5 kB",
      "ignore": [
        "react",
        "@unruffled/core"
      ]
    },
    {
      "name": "useUndoable + core",
      "path": "dist/undoable.js",
      "limit": "8 kB",
      "ignore": [
        "react"
      ]
    },
    {
      "name": "useUndoable, react layer only",
      "path": "dist/undoable.js",
      "limit": "2.5 kB",
      "ignore": [
        "react",
        "@unruffled/core"
      ]
    }
  ]
}
