{
  "name": "@unruffled/intl",
  "version": "0.1.0",
  "description": "Shipped, versioned announcement and action strings for unruffled. An interface plus en, de, fr and es catalogs, bundled one active locale at a time.",
  "license": "MIT",
  "author": "Abdul Manan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdulmanan69/ui-ux.git",
    "directory": "packages/intl"
  },
  "homepage": "https://abdulmanan69.github.io/ui-ux/",
  "bugs": "https://github.com/abdulmanan69/ui-ux/issues",
  "keywords": [
    "unruffled",
    "ux",
    "i18n",
    "intl",
    "localization",
    "accessibility",
    "aria"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/index.development.js",
      "default": "./dist/index.js"
    },
    "./en": {
      "types": "./dist/locales/en.d.ts",
      "development": "./dist/locales/en.development.js",
      "default": "./dist/locales/en.js"
    },
    "./de": {
      "types": "./dist/locales/de.d.ts",
      "development": "./dist/locales/de.development.js",
      "default": "./dist/locales/de.js"
    },
    "./fr": {
      "types": "./dist/locales/fr.d.ts",
      "development": "./dist/locales/fr.development.js",
      "default": "./dist/locales/fr.js"
    },
    "./es": {
      "types": "./dist/locales/es.d.ts",
      "development": "./dist/locales/es.development.js",
      "default": "./dist/locales/es.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsdown && tsdown -c tsdown.dev.config.ts",
    "dev": "tsdown -c tsdown.dev.config.ts --watch",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "@unruffled/intl + en catalog",
      "path": "dist/locales/en.js",
      "limit": "1 kB"
    }
  ]
}
