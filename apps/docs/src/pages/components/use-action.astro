/**
 * useAction reference.
 *
 * The flagship page. Everything here is checked against the source: the six states and
 * their transitions come from `packages/core/src/machines/action/machine.ts`, the three
 * tables from `types.ts`, `connect.ts` and `packages/react/src/action.ts`, and the four
 * diagnostic rules from `packages/core/src/diagnostics.ts`.
 */
import DocPage from "../../components/docs/DocPage.astro";
import Section from "../../components/docs/Section.astro";
import Snippet from "../../components/docs/Snippet.astro";
import Demo from "../../components/docs/Demo.astro";
import Callout from "../../components/docs/Callout.astro";
import PropsTable from "../../components/docs/PropsTable.astro";
import Keys from "../../components/docs/Keys.astro";
import Mistake from "../../components/docs/Mistake.astro";
import { href } from "../../lib/site";
import { AsyncButtonDemo, GuardDemo, RetryDemo } from "../../components/demos/index.tsx";
import TimingTrace from "../../components/TimingTrace.tsx";

const installCode = `npm install @unruffled/react`;

const rootCode = `import { Announcer } from "@unruffled/react";

export function App({ children }: { children: React.ReactNode }) {
  return (
    <>
      {children}
      <Announcer />
    </>
  );
}`;

const basicCode = `import { useAction } from "@unruffled/react";

export function SaveCustomer({ id, form }: Props) {
  const save = useAction(() => api.saveCustomer(id, form), {
    key: \`customer:\${id}\`,
    announce: { success: "Customer saved" },
    onError: (failure) => {
      toast(failure.message);
    },
  });

  return (
    <button {...save.triggerProps}>
      {save.pending ? "Saving..." : "Save customer"}
    </button>
  );
}`;

const pendingVsBusyCode = `// busy    — work is in flight or settling. Drives aria-busy. True from the first
//            millisecond of the request.
// pending — the affordance should render. False for the first 150 ms, and still
//            true for up to 400 ms after the request has already resolved.

<button {...save.triggerProps}>
  {save.pending ? <Spinner /> : null}
  {save.pending ? "Saving" : "Save customer"}
</button>`;

const keyCode = `// Two components, two subtrees, one record.

function InvoiceToolbar({ id }: { id: string }) {
  const approve = useAction(() => api.approve(id), { key: \`invoice:\${id}\` });
  return <button {...approve.triggerProps}>Approve</button>;
}

function InvoiceRow({ id }: { id: string }) {
  const approve = useAction(() => api.approve(id), { key: \`invoice:\${id}\` });
  return <button {...approve.triggerProps}>Approve</button>;
}`;

const registryCode = `import { createKeyRegistry } from "@unruffled/core";

// One registry per test case, so a lock left behind by one case cannot
// make the next one look like a duplicate submit.
const registry = createKeyRegistry();

const save = useAction(run, { key: "customer:42", registry });`;

const concurrentCode = `// Adding separate items to a cart is additive, not a duplicate submit.
const addToCart = useAction((sku: string) => api.addToCart(sku), {
  guard: "allow-concurrent",
});`;

const retryCode = `const save = useAction(() => api.saveCustomer(form), {
  key: \`customer:\${id}\`,
  retry: { attempts: 2, backoff: { baseMs: 500, factor: 2, maxMs: 30_000, jitter: 0.5 } },
});

// \`backoff\` is a real state, so the wait is renderable rather than a hang.
<button {...save.triggerProps}>
  {save.state === "backoff" && save.retryInMs !== null
    ? \`Retrying in \${Math.ceil(save.retryInMs / 1000)}s\`
    : save.pending
      ? "Saving"
      : "Save"}
</button>`;

const manualRetryCode = `// No retry policy: nothing retries by itself, and \`canRetry\` says whether
// offering the affordance would be honest for this particular failure.
const save = useAction(() => api.saveCustomer(form), { key: "customer:42" });

{save.status === "error" ? (
  <div role="group">
    <p>{save.failure?.message}</p>
    {save.canRetry ? <button onClick={save.retry}>Try again</button> : null}
  </div>
) : null}`;

const argsCode = `// One hook, one row per item. The argument travels with the trigger.
const remove = useAction((sku: string) => api.removeLine(sku), {
  key: \`cart:\${cartId}\`,
});

return lines.map((line) => (
  <button
    key={line.sku}
    {...remove.getTriggerProps({
      args: line.sku,
      onClick: () => {
        analytics.track("line_removed", { sku: line.sku });
      },
    })}
  >
    Remove
  </button>
));`;

const cancelCode = `const upload = useAction((file: File, signal: AbortSignal) =>
  fetch("/api/upload", { method: "POST", body: file, signal }),
);

<>
  <button {...upload.getTriggerProps({ args: file })}>Upload</button>
  {upload.busy ? <button onClick={upload.cancel}>Cancel</button> : null}
</>`;

const nonButtonCode = `// A div given a button role. The hook synthesises Enter and Space here,
// because there is no native activation to piggyback on.
<div role="button" tabIndex={0} {...save.triggerProps}>
  {save.pending ? "Saving" : "Save"}
</div>`;

const stylingCode = `/* The trigger carries the whole lifecycle as attributes. No class names,
   no inline styles, nothing to override. */

button[data-pending] .spinner { display: inline-block; }
button[aria-busy="true"]      { cursor: progress; }
button[data-state="backoff"]  { border-color: var(--warning); }
button[data-attempt]::after   { content: " (attempt " attr(data-attempt) ")"; }

@media (prefers-reduced-motion: reduce) {
  .spinner { animation: none; }
}`;

const providerCode = `import { UnruffledProvider } from "@unruffled/react";

// Timing policy and failure copy in one place. The provider is optional and
// every hook works without it.
<UnruffledProvider
  defaults={{
    pending: { delay: 0, min: 250 },
    messages: { retryable: "Das hat nicht funktioniert. Bitte erneut versuchen." },
    classify: (failure) => (failure.status === 418 ? "terminal" : undefined),
  }}
>
  <App />
</UnruffledProvider>`;

const classifyCode = `const save = useAction(() => api.saveCustomer(form), {
  // Our gateway returns 503 for a planned maintenance window, which is not
  // worth an automatic retry. Returning undefined keeps the default mapping
  // for every other status.
  classify: (failure) =>
    failure.status === 503 && failure.detail?.includes("maintenance") ? "terminal" : undefined,
});`;

const formCode = `function CustomerForm({ id }: { id: string }) {
  const save = useAction((_args: void, signal) => api.saveCustomer(id, read(), signal), {
    key: \`customer:\${id}\`,
    announce: { success: "Customer saved" },
    onError: () => {
      // Rendered below, so UX1004 stays quiet.
    },
  });

  const failure = useFailure(save.failure);
  const fieldError = (path: string) =>
    failure?.fields?.find((field) => field.path === path)?.message;

  return (
    <form onSubmit={(event) => { event.preventDefault(); save.trigger(); }}>
      <Field name="email" error={fieldError("email")} />

      {/* A validation failure is already on the fields. Anything else needs a summary. */}
      {failure && failure.kind !== "validation" ? (
        <p {...failure.summaryProps}>{failure.message}</p>
      ) : null}

      <button {...save.triggerProps}>
        {save.pending ? "Saving" : "Save"}
      </button>
    </form>
  );
}`;

const resetCode = `// A settled result persists by default, because a tick that vanishes before
// the user has looked up from the keyboard never happened as far as they are
// concerned. Opt into clearing it when the surface is transient.
const save = useAction(run, { key: "customer:42", resetAfterMs: 4000 });

{save.status === "success" ? <p role="status">Saved</p> : null}`;

const destructiveCode = `// \`destructive\` without \`reversible\` reports UX1001 in a development build.
// v0.1.0 does not ship the confirm and undo primitives that will set
// \`reversible\` for you, so set it once you have provided a recovery path.
const remove = useAction(() => api.deleteCustomer(id), {
  key: \`customer:\${id}\`,
  destructive: true,
  reversible: true, // we keep a 10s undo window ourselves
  announce: { success: "Customer deleted. Undo available for 10 seconds." },
});`;

const testCode = `import { createTestPorts } from "@unruffled/testing";

// Module scope, so the port identity is stable across renders.
const ports = createTestPorts();

function Save() {
  const save = useAction(run, { key: "customer:42", ports });
  return <button {...save.triggerProps}>{save.pending ? "Saving" : "Save"}</button>;
}

// The thresholds are asserted by advancing a counter, not by sleeping.
render(<Save />);
await user.click(screen.getByRole("button"));

act(() => { ports.clock.advance(149); });
expect(screen.getByRole("button")).not.toHaveAttribute("data-pending");

act(() => { ports.clock.advance(1); });
expect(screen.getByRole("button")).toHaveAttribute("data-pending");`;

const optionRows = [
  {
    name: "run",
    type: "(args: A, signal: AbortSignal) => Promise<T>",
    default: "required",
    description:
      "The work. The first argument to the hook, not a member of the options object. It receives the trigger arguments and an abort signal, and it is replaced on every committed render, so reading fresh state inside it is safe.",
    why: "A handler captured at mount calls last render's function with last render's state. That stale-closure hazard is the defect hand-rolled versions of this hook almost always carry.",
  },
  {
    name: "key",
    type: "string",
    description:
      "Resource identity, for example customer:42. Actions declaring the same key are serialised across the whole application through one registry, so a second trigger coming from a different subtree is refused.",
  },
  {
    name: "registry",
    type: "KeyRegistry",
    default: "the process-wide registry",
    description:
      "The registry backing key. Replace it to isolate a test, a sandbox or an embedded widget from the rest of the page.",
  },
  {
    name: "guard",
    type: '"single-flight" | "allow-concurrent"',
    default: '"single-flight"',
    description:
      "How overlapping triggers are handled. Single-flight refuses a trigger while the key is held. Allow-concurrent lets every trigger start.",
    why: "Single-flight is the default because an overlapping trigger is almost always a duplicate submit. The guard is read synchronously inside the event handler, before any await and before any validation, so there is no window in which a second click is accepted. Allow-concurrent is only correct for genuinely additive work, such as adding separate items to a cart.",
  },
  {
    name: "pending",
    type: "Partial<PendingPolicy>",
    default: "delay 150, min 400",
    description:
      "When the pending affordance appears, and the minimum time it stays once it has appeared. Both are milliseconds.",
    why: "The delay of 150 suppresses the affordance entirely for fast actions: a 60 ms save that flashes a spinner reads as a glitch, not as feedback. The minimum of 400 keeps it visible long enough to be perceived, so an action that resolves at 160 ms does not produce a 10 ms flicker. They are two thresholds because they solve two different problems.",
  },
  {
    name: "destructive",
    type: "boolean",
    default: "false",
    description:
      "Marks the action irreversible. In a development build, true without reversible reports UX1001 on the first trigger.",
