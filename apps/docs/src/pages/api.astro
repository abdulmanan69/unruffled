const testCode = `import { createTestPorts, flushMicrotasks } from "@unruffled/testing";

test("no spinner before 150ms", async () => {
  const ports = createTestPorts();
  const { result } = renderHook(() =>
    useAction(() => resolveAfter(900), { ports }),
  );

  act(() => result.current.trigger());
  act(() => ports.clock.advance(149));
  expect(result.current.pending).toBe(false);

  act(() => ports.clock.advance(1));
  expect(result.current.pending).toBe(true);

  act(() => ports.clock.advance(751));
  await flushMicrotasks();
  expect(ports.announcer.at("polite")).toHaveLength(1);
});`;

