---
/**
 * One documentation section with a linkable heading.
 *
 * The anchor is rendered as a real link rather than appearing on hover, so it is reachable
 * by keyboard and discoverable without a pointer.
 */
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<section class="doc-section" id={id}>
  <h2>
    <a class="doc-anchor" href={`#${id}`}>{title}</a>
  </h2>
  <slot />
</section>

<style>
  .doc-anchor {
    text-decoration: none;
    color: inherit;
  }
  .doc-anchor::after {
    content: " #";
    color: var(--rule-strong);
    font-family: var(--font-mono);
    font-size: 0.6em;
    vertical-align: 0.4em;
  }
  .doc-anchor:hover::after {
    color: var(--signal);
  }
</style>
