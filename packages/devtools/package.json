{
  "name": "@unruffled/devtools",
  "version": "0.1.0",
  "description": "Development-only diagnostics for unruffled. Warns with stable UX#### codes when a call site is unsafe - a destructive action with no undo path, a long pending state with no live region, an undo window with no navigation flush.",
  "license": "MIT",
  "author": "Abdul Manan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdulmanan69/unruffled.git",
    "directory": "packages/devtools"
  },
  "homepage": "https://abdulmanan69.github.io/unruffled/",
  "bugs": "https://github.com/abdulmanan69/unruffled/issues",
  "keywords": [
    "unruffled",
    "ux",
    "devtools",
    "diagnostics",
    "accessibility",
    "linting",
    "developer-experience"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/index.development.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@unruffled/core": "workspace:^"
  },
  "scripts": {
    "build": "tsdown && tsdown -c tsdown.dev.config.ts",
    "dev": "tsdown -c tsdown.dev.config.ts --watch",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "@unruffled/devtools (production build is empty)",
      "path": "dist/index.js",
      "limit": "0.3 kB",
      "ignore": [
        "@unruffled/core"
      ]
    }
  ]
}
