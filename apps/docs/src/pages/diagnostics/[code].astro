---
/**
 * One page per diagnostic code, generated from the rule table.
 *
 * This is what makes the `Docs:` line the console prints a real link. A diagnostic that
 * tells you a code and then has nowhere to send you is only half a diagnostic.
 */
import Base from "../../layouts/Base.astro";
import { RULES, type DiagnosticCode } from "@unruffled/core/diagnostics";
import { href } from "../../lib/site";

export function getStaticPaths() {
  return (Object.keys(RULES) as DiagnosticCode[]).map((code) => ({
    params: { code: code.toLowerCase() },
    props: { code },
  }));
}

interface Props {
  code: DiagnosticCode;
}

const { code } = Astro.props;
const rule = RULES[code];

const codes = Object.keys(RULES) as DiagnosticCode[];
const index = codes.indexOf(code);
const previous = index > 0 ? codes[index - 1] : undefined;
const next = index < codes.length - 1 ? codes[index + 1] : undefined;

const suppressSnippet = `import { diagnostics } from "@unruffled/core/diagnostics";

diagnostics.suppress("${code}");`;

/**
 * Be precise about what actually reports each rule today.
 *
 * UX1001 to UX1004 have report sites in the action machine, and UX1007 has one in the
 * undoable machine. The rest describe defects the library has named but cannot yet observe,
 * because the primitive that would detect them is not in 0.1.0. Saying otherwise would make
 * the documentation claim a diagnostic that never fires.
 */
const REPORTED_TODAY: Partial<Record<DiagnosticCode, string>> = {
  UX1001: "action",
  UX1002: "action",
  UX1003: "action",
  UX1004: "action",
  UX1007: "undoable",
};

const reportingMachine = REPORTED_TODAY[code];

const detection = reportingMachine
  ? `The diagnostics bus reports this at runtime, from the ${reportingMachine} machine, in development builds. It is reported once per code per call site, so a rule inside a list row does not bury the console.`
  : rule.static
    ? "This condition is decidable from source, so it is a candidate for a lint rule rather than a runtime check. Nothing reports it yet: the primitive it describes is not part of 0.1.0, and the lint plugin is not written. The rule is published so the code is stable before anything emits it."
    : "Nothing reports this yet. It describes a defect in a primitive that is not part of 0.1.0, and the rule is published so the code is stable before anything emits it.";
---

<Base title={`${code} · ${rule.title}`} path={`diagnostics/${code.toLowerCase()}`} description={rule.detail}>
  <nav class="crumb" aria-label="Breadcrumb">
    <a href={href("diagnostics")}>Diagnostics</a>
    <span aria-hidden="true">/</span>
    <span>{code}</span>
  </nav>

  <header class="page-head" data-severity={rule.severity}>
    <p class="label">{rule.severity === "error" ? "Error" : "Warning"}</p>
    <h1>{rule.title}</h1>
  </header>

  <div class="prose">
    <h2>What went wrong</h2>
    <p>{rule.detail}</p>

    <h2>How to fix it</h2>
    <p>{rule.fix}</p>

    <h2>What reports it</h2>
    <p>{detection}</p>

    <h2>Suppressing it</h2>
    <p>
      If you have considered it and the rule is wrong for your case, silence that one code for the session.
      The bus already de-duplicates by code and call site, so you will not need this to quiet noise.
    </p>
    <pre><code>{suppressSnippet}</code></pre>

    <h2>Does this cost anything in production?</h2>
    <p>
      No. The rule table and the bus live on the <code>@unruffled/core/diagnostics</code> subpath, which nothing
      in a production code path imports. Every report site is behind a build-time flag, so the call and its arguments
      are removed outright rather than left as dead code.
    </p>
  </div>

  <nav class="pager" aria-label="Rules">
    {previous ? <a href={href(`diagnostics/${previous.toLowerCase()}`)}>&larr; {previous}</a> : <span />}
    {next ? <a href={href(`diagnostics/${next.toLowerCase()}`)}>{next} &rarr;</a> : <span />}
  </nav>
</Base>

<style>
  .crumb {
    display: flex;
    gap: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--graphite);
    margin-bottom: var(--s-4);
  }

  .crumb a {
    color: var(--graphite);
  }

  .page-head {
    display: grid;
    gap: var(--s-3);
    max-width: 68ch;
    margin-bottom: var(--s-6);
    padding-left: var(--s-4);
    border-left: 2px solid var(--fault);
  }

  .page-head[data-severity="warning"] {
    border-left-color: var(--held);
  }

  .page-head .label {
    color: var(--fault);
  }

  .page-head[data-severity="warning"] .label {
    color: var(--held);
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    margin-top: var(--s-8);
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
</style>
