export function App({ children }: { children: React.ReactNode }) {
  return (
    <>
      {children}
      {/* Once. A second one replaces the first's registration. */}
      <Announcer />
    </>
  );
}`;

const announcerMarkupCode = `<!-- What Announcer renders. Both regions are clipped, never hidden:
     display:none, visibility:hidden and the hidden attribute all remove
     an element from the accessibility tree and make the region silent. -->
<div aria-live="polite" aria-atomic="true" style="…clip-path: inset(50%)…" />
<div role="alert" aria-live="assertive" aria-atomic="true" style="…" />`;

const announceCode = `const { announce, live } = useAnnounce();

// Politeness defaults to "polite". "assertive" interrupts and is for failures.
announce("Filters cleared, 240 results");

// \`live\` is what lets a test assert that announcements were deliverable
// rather than assuming it.
expect(live).toBe(true);`;

