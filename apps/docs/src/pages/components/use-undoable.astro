/**
 * useUndoable reference.
 *
 * Every claim here is checked against the source: the five states and their transitions
 * come from `packages/core/src/machines/undoable/machine.ts`, the option table from
 * `types.ts`, the result table from `connect.ts` and `packages/react/src/undoable.ts`, the
 * flush events from `packages/react/src/adapter/domPorts.ts`, and the guaranteed behaviour
 * from `packages/core/test/undoable.test.ts`.
 */
import DocPage from "../../components/docs/DocPage.astro";
import Section from "../../components/docs/Section.astro";
import Snippet from "../../components/docs/Snippet.astro";
import Demo from "../../components/docs/Demo.astro";
import Callout from "../../components/docs/Callout.astro";
import PropsTable from "../../components/docs/PropsTable.astro";
import Keys from "../../components/docs/Keys.astro";
import Mistake from "../../components/docs/Mistake.astro";
import { href } from "../../lib/site";
import { UndoableDemo } from "../../components/demos/index.tsx";

const basicCode = `import { useState } from "react";
import { useUndoable } from "@unruffled/react";

export function InvoiceList({ invoices }: { invoices: Invoice[] }) {
  const [rows, setRows] = useState(invoices);

  const deletion = useUndoable<Invoice>({
    // The write. Not sent until the window closes.
    commit: (batch) => api.deleteInvoices(batch.map((row) => row.id)),
    // Puts the local change back. Runs on undo, and only on undo.
    rollback: (batch) => setRows((current) => [...current, ...batch]),
    coalesce: "invoice-delete",
    altText: "Undo delete",
    announce: { scheduled: "Deleted", committed: "Delete saved" },
  });

  const remove = (row: Invoice) => {
    // Optimistic, and local only. No request in this handler.
    setRows((current) => current.filter((item) => item.id !== row.id));
    deletion.schedule(row);
  };

  return (
    <>
      <ul>
        {rows.map((row) => (
          <li key={row.id}>
            {row.number}
            <button type="button" onClick={() => remove(row)}>
              Delete
            </button>
          </li>
        ))}
      </ul>

      {deletion.canUndo ? (
        <p role="status">
          {deletion.count} deleted
          <button {...deletion.undoProps}>Undo</button>
        </p>
      ) : null}
    </>
  );
}`;

const flushOnCode = `// The default. Both exits flush, because a window that does not survive
// navigation loses the write.
const deletion = useUndoable<Row>({
  commit,
  altText: "Undo delete",
  flushOn: ["navigate", "pagehide"],
});

// The opt-out, written down rather than arrived at by accident: a window
// interrupted by navigation may be lost, and UX1007 stays quiet because the
// decision was deliberate.
const draft = useUndoable<Row>({ commit, altText: "Undo", flushOn: [] });`;

const coalesceCode = `// Five deletes in a row are one entry with a count and one restarted window.
const deletion = useUndoable<Row>({
  commit: (batch) => api.deleteRows(batch.map((row) => row.id)),
  coalesce: "row-delete",
  altText: "Undo delete",
});

{deletion.canUndo ? (
  <p role="status">
    {deletion.count === 1 ? "1 row deleted" : \`\${deletion.count} rows deleted\`}
    <button {...deletion.undoProps}>Undo</button>
  </p>
) : null}`;

const keyCode = `// The key is held for the whole window and the request that follows it, so a
// save on the same record cannot land in the middle of a deferred delete.
const deletion = useUndoable<Invoice>({
  commit: (batch) => api.deleteInvoices(batch.map((row) => row.id)),
  key: \`invoice:\${id}\`,
  altText: "Undo delete",
});

const save = useAction(() => api.saveInvoice(id, form), {
  key: \`invoice:\${id}\`,
});`;

const toastCode = `import type { CSSProperties } from "react";

// One timer, and it belongs to the machine. The toast's lifetime is derived
// from remainingMs, so coalescing a repeat extends both at once.
{deletion.canUndo ? (
  <Toast
    {...deletion.attrs}
    duration={deletion.remainingMs ?? 0}
    style={{ "--undo-progress": deletion.progress ?? 0 } as CSSProperties}
  >
    {deletion.count} deleted
    <button {...deletion.undoProps}>Undo</button>
  </Toast>
) : null}`;

const progressCode = `/* The ring is interpolated by the compositor from a custom property, so the
   toast does not re-render once per frame to animate it. */

.undo-ring {
  stroke-dashoffset: calc(var(--undo-circumference) * var(--undo-progress, 0));
}

@media (prefers-reduced-motion: reduce) {
  /* The number keeps counting; only the ring stops. */
  .undo-ring {
    display: none;
  }
}`;

const failedCode = `// The batch is kept, so a retry sends the same items. flush() is the retry.
{deletion.state === "failed" ? (
  <div role="group">
    <p>{deletion.failure?.message}</p>
    <button type="button" onClick={deletion.flush}>
      Try again
    </button>
    <button type="button" onClick={deletion.reset}>
      Dismiss
    </button>
  </div>
) : null}`;

const optionRows = [
  {
    name: "commit",
    type: "(items: readonly T[], signal: AbortSignal) => Promise<unknown>",
    default: "required",
    description:
      "The deferred write. Called once per committed batch, with every item in it. Replaced on every host render, so reading fresh state inside it is safe. It receives an abort signal for symmetry with the rest of the library, and nothing in this machine ever aborts it.",
    why: "A commit that has been sent is a write the user is owed. Everywhere else in the library disposal aborts the request; here it must not, because the user was already told the change had happened.",
  },
  {
    name: "altText",
    type: "string",
    default: "required",
    description:
      "Accessible label for the undo affordance. It lands on undoProps as aria-label, and getUndoProps can override it per control.",
    why: "It is required by the type rather than defaulted because an icon-only Undo is how this pattern normally ships broken: the window exists, the request is correctly deferred, and the one control that cancels it has no name in the accessibility tree. A delete with an unreachable undo is a delete with no undo.",
  },
  {
    name: "rollback",
    type: "(items: readonly T[]) => void",
    default: "undefined",
    description:
      "Undoes the optimistic local change. Called on undo, inside the transition, before the window closes, and never after a commit has been sent.",
  },
  {
    name: "windowMs",
    type: "number",
    default: "6000",
    description: "Milliseconds the window stays open. A repeat that coalesces restarts it from the merge.",
    why: "6000 is long enough to read “Deleted” and reach for Undo, and short enough that the interface is not lying for long about a change it has not made yet. Below roughly 3000 the affordance is gone before a user who was reading something else can act on it; past 10000 a queue of pending writes builds up behind a user who keeps working.",
  },
  {
    name: "coalesce",
    type: "string",
    default: "undefined",
    description:
      "Merge tag for repeats. Schedules sharing a tag append to the open entry and restart its window, as one entry with a count. Without a tag, a second schedule flushes the open entry and queues itself behind it.",
  },
  {
    name: "key",
    type: "string",
    default: "undefined",
    description:
      "Resource identity, for example invoice:42. Held from the moment the window opens until the commit settles or the entry is undone, so an action writing the same record cannot land in the middle of a deferred delete.",
  },
  {
    name: "registry",
    type: "KeyRegistry",
    default: "the process-wide registry",
    description:
      "The registry backing key. Replace it to isolate a test, a sandbox or an embedded widget from the rest of the page.",
  },
  {
    name: "flushOn",
    type: 'readonly ("navigate" | "pagehide")[]',
    default: '["navigate", "pagehide"]',
    description:
      "Which exits commit an open window early. navigate is an in-app route change reported by a router binding; pagehide is the document going away, which the DOM port raises from both pagehide and a visibilitychange to hidden. An empty array is the explicit opt-out and also silences UX1007.",
    why: "Defaulted to both exits rather than to none, because a window that does not survive navigation loses the write, and that is the failure this machine exists to stop.",
  },
  {
    name: "announce",
    type: "false | UndoableAnnouncements",
    default: "undefined",
    description:
      "Strings read to assistive technology: scheduled, undone and committed. Each is silent when omitted. A failed commit announces the normalised failure message assertively with no configuration. Setting the option to false opts out of all four.",
  },
  {
    name: "classify",
    type: "(failure: NormalizedFailure) => FailureKind | undefined",
    default: "the provider's classify",
    description:
      "Overrides failure classification for a failed commit. Returning undefined keeps the default status mapping, so one case can be special-cased without restating the table.",
  },
  {
    name: "messages",
    type: "Partial<Record<FailureKind, string>>",
    default: "built-in copy, merged over the provider's",
    description: "User-facing copy per failure kind, so the taxonomy can be localised.",
  },
  {
    name: "online",
    type: "() => boolean",
    default: "navigator.onLine",
    description:
      "Whether the client believes it has a network, read when a failed commit is classified so an offline failure is labelled offline rather than reported as a generic server error. Returns true when navigator is undefined, which is the server case.",
  },
  {
    name: "onCommitted",
    type: "(items: readonly T[]) => void",
    default: "undefined",
    description: "Called on entry to committed, with the batch that was sent.",
  },
  {
    name: "onUndone",
    type: "(items: readonly T[]) => void",
    default: "undefined",
    description:
      "Called in the undo transition, with the batch that was discarded, after rollback has run. Nothing was sent, so there is nothing to reverse here.",
  },
  {
    name: "onCommitFailed",
    type: "(failure: NormalizedFailure) => void",
    default: "undefined",
    description:
      "Called on entry to failed, with the normalised failure. The items are still on the hook, so a retry sends the same batch.",
  },
  {
    name: "ports",
    type: "Partial<Ports>",
    default: "provider, then DOM",
    description:
      "Replaces individual ports. Resolution order is this override, then the provider's ports, then DOM-backed ports. Swap the clock to assert the window by advancing a counter rather than by sleeping.",
  },
  {
    name: "root",
    type: "PortRoot",
    default: "the owning document",
    description:
      "Scopes listeners and focus reads to a shadow root or a secondary window, so a deferred write inside a web component still hears that window going away.",
  },
];

const resultRows = [
  {
    name: "state",
    type: '"idle" | "held" | "committing" | "committed" | "failed"',
    description: "The raw machine state. Also on the toast element as data-state, for styling.",
  },
  {
    name: "status",
    type: "the same five values",
    description:
      "An alias of state, not a narrower union. Every state here is one a user can distinguish, so there is nothing to collapse.",
  },
  {
    name: "canUndo",
    type: "boolean",
    description: "True in held and nowhere else. Render the undo control on this and remove it afterwards.",
    why: "Once the commit is in flight there is nothing to cancel. An Undo control rendered past this point is the lie the primitive exists to prevent.",
  },
  {
    name: "items",
    type: "readonly T[]",
    description:
      "The pending or in-flight batch, in the order it was scheduled. Still populated in failed, so a retry sends the same items.",
  },
  { name: "count", type: "number", description: "items.length. The number in “3 rows deleted”." },
  {
    name: "expiresAt",
    type: "number | null",
    description:
      "Clock reading at which the window closes, or null whenever undo is not available. A reading rather than a duration, because a duration is stale the moment it is read.",
  },
  {
    name: "remainingMs",
    type: "number | null",
    description:
      "Live milliseconds left in the window, derived from expiresAt through the shared frame loop. Bucketed to 100 ms, or to 1000 ms under reduced motion, so it keeps counting without costing sixty renders a second.",
  },
  {
    name: "progress",
    type: "number | null",
    description:
      "0 when the window opens, 1 when it closes, null when none is open. Hand it to CSS as a custom property and let the compositor draw the ring.",
  },
  {
    name: "failure",
    type: "NormalizedFailure | null",
    description:
      "The normalised failure from a commit that rejected, carrying kind, message, detail, status, retryAfterMs, fields, canRetry and raw. An abort is reported as a failure here, unlike in useAction.",
  },
  {
    name: "schedule(item)",
    type: "(item: T) => void",
    description:
      "Adds an item to the batch: opens a window, merges into the open one when the coalesce tag matches, or queues behind a flush in progress.",
  },
  {
    name: "undo()",
    type: "() => void",
    description:
      "Rolls the optimistic change back and discards the write. Ignored unless canUndo, so a late press does nothing rather than reversing a commit.",
  },
  {
    name: "flush()",
    type: "() => void",
    description:
      "Commits now, without waiting for the window. From failed it retries the same batch, because that is the same request from the caller's point of view.",
  },
  {
    name: "reset()",
    type: "() => void",
    description:
      "Clears a settled entry. A pending window is left alone: use undo or flush, so a reset cannot silently drop a write.",
  },
  {
    name: "attrs",
    type: "UndoableAttrs",
    description:
      "data-state, data-count and aria-busy, framework-neutral. Spread them on the toast or region that hosts the affordance.",
  },
  {
    name: "undoProps",
    type: "UndoProps",
    description:
      'Spread straight onto the undo control: type="button", aria-label from altText, and onClick. There is no disabled key.',
  },
  {
    name: "getUndoProps(overrides?)",
    type: "(overrides?: UndoPropOverrides) => UndoProps",
    description:
      "The same props with onClick or altText composed in. Your handler runs after the library's. disabled is typed as never.",
  },
];

const keyRows = [
  {
    keys: ["Tab"],
    action:
      "Moves to and from the undo control. It stays in the tab order for the whole window, because it is never disabled.",
  },
  {
    keys: ["Enter"],
    action:
      "Presses Undo: rollback runs and the write is discarded. undoProps carries only onClick, so this is the browser's own button activation and nothing fires twice.",
  },
  { keys: ["Space"], action: "Presses Undo, by the same route." },
  {
    keys: ["Escape"],
    action:
      "Nothing. The hook binds no global keys. If your toast closes on Escape, close the toast — do not wire that to undo(), because dismissing a message is not the same decision as cancelling a write.",
  },
