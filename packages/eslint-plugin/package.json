{
  "name": "@unruffled/eslint-plugin",
  "version": "0.1.0",
  "description": "The statically checkable subset of the unruffled diagnostics rule table, as ESLint rules. Same UX#### codes as the runtime bus and the test-time matchers.",
  "license": "MIT",
  "author": "Abdul Manan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdulmanan69/unruffled.git",
    "directory": "packages/eslint-plugin"
  },
  "homepage": "https://abdulmanan69.github.io/unruffled/",
  "bugs": "https://github.com/abdulmanan69/unruffled/issues",
  "keywords": [
    "unruffled",
    "ux",
    "eslint",
    "eslint-plugin",
    "accessibility",
    "linting",
    "static-analysis"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/index.development.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.19"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "scripts": {
    "build": "tsdown && tsdown -c tsdown.dev.config.ts",
    "dev": "tsdown -c tsdown.dev.config.ts --watch"
  }
}
