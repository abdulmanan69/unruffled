    default: '"restore"',
    description:
      "Where focus goes once the action settles. Restore refocuses the trigger only when focus was lost while the action ran, which happens when the surrounding subtree was replaced mid-flight. None leaves focus alone.",
  },
  {
    name: "resetAfterMs",
    type: "number | false",
    default: "undefined",
    description:
      "Milliseconds after which a settled action returns to idle. Undefined or false keeps the result on screen indefinitely.",
    why: "The result persists by default. A confirmation that disappears before the user has looked up from the keyboard did not happen as far as they are concerned.",
  },
  {
    name: "retry",
    type: "RetryPolicy",
    default: "undefined",
    description:
      "attempts is the number of automatic retries after the first attempt; zero or omitted means manual retry only. backoff takes baseMs, factor, maxMs and jitter. An automatic retry only fires for a failure whose canRetry is true.",
  },
  {
    name: "classify",
    type: "(failure: NormalizedFailure) => FailureKind | undefined",
    default: "undefined",
    description:
      "Overrides failure classification. Returning undefined falls through to the default status mapping, so one status can be special-cased without restating the table.",
  },
  {
    name: "messages",
    type: "Partial<Record<FailureKind, string>>",
    default: "built-in copy",
    description:
      "User-facing copy per failure kind, so the taxonomy can be localised without re-implementing it.",
  },
  {
    name: "online",
    type: "() => boolean",
    default: "navigator.onLine",
    description:
      "Whether the client believes it has a network, read at classification time so an offline failure is labelled offline rather than reported as a generic network error. Returns true when navigator is undefined, which is the server case.",
  },
  {
    name: "onSuccess",
    type: "(value: T) => void",
    default: "undefined",
    description: "Called on entry to success, with the resolved value, before onSettled.",
  },
  {
    name: "onError",
    type: "(failure: NormalizedFailure) => void",
    default: "undefined",
    description:
      "Called on entry to error, with the normalised failure, before onSettled. Its absence reports UX1004 in a development build, because a rejection that reaches the console but not the user makes a failed save look identical to a successful one.",
  },
  {
