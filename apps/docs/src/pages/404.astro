---
/**
 * Not found.
 *
 * GitHub Pages serves `404.html` for any unmatched path, so this is the page a mistyped or
 * stale URL lands on. Treated as a navigation problem rather than a mood: it says what
 * happened and offers the places someone was most likely heading.
 */
import Base from "../layouts/Base.astro";
import { href } from "../lib/site";

const destinations = [
  { label: "Overview", path: "", note: "What the library does and why it exists" },
  { label: "Getting started", path: "getting-started", note: "Install it and wire the first action" },
  { label: "Playground", path: "playground", note: "Drive every state by hand" },
  { label: "Diagnostics", path: "diagnostics", note: "Arriving from a UX#### console message" },
];
---

<Base
  title="Page not found"
  path="404"
  sidebar={false}
  description="That page does not exist. Here are the places people are usually heading."
>
  <section class="shell notfound">
    <p class="label">404</p>
    <h1>That page does not exist.</h1>
    <p class="notfound__lede">
      The link may be out of date, or the address may have a typo. Nothing is broken on your side.
    </p>

    <ul class="notfound__links">
      {
        destinations.map((destination) => (
          <li>
            <a href={href(destination.path)}>{destination.label}</a>
            <span>{destination.note}</span>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .notfound {
    display: grid;
    gap: var(--s-4);
    padding-block: var(--s-9) var(--s-10);
    max-width: 62ch;
  }

  .notfound__lede {
    color: var(--ink-soft);
  }

  .notfound__links {
    display: grid;
    gap: 0;
    margin: var(--s-4) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .notfound__links li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3);
    padding: var(--s-4) 0;
    border-bottom: 1px solid var(--rule);
  }

  .notfound__links a {
    font-family: var(--font-display);
    font-size: var(--text-md);
    letter-spacing: var(--tracking-tight);
  }

  .notfound__links span {
    font-size: var(--text-sm);
    color: var(--graphite);
  }
</style>
